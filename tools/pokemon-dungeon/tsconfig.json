{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "three": ["./node_modules/@types/three/index.d.ts"],
      "three/addons/*": ["./node_modules/@types/three/examples/jsm/*"]
    }
  },
  "include": [
    "../../games/pokemon-dungeon-reimagined/src/**/*.js",
    "art-preview/**/*.js"
  ],
  "exclude": ["node_modules", "../../games/pokemon-dungeon-reimagined/vendor"]
}
