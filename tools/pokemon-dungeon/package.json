{
  "name": "pokemon-dungeon-authoring",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static authoring and validation tools for Pok\u00e9mon Dungeon Reimagined",
  "packageManager": "npm@12.1.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.1.0 <13"
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "lint": "node scripts/check-source.mjs",
    "typecheck": "node scripts/check-types.mjs",
    "assets": "node scripts/check-assets.mjs && npm run pixel:check && npm run production:check && npm run roster:check && npm run runtime-pixels:check && npm run environment:check",
    "art:export": "node art/export.mjs",
    "check": "npm run lint && npm run typecheck && npm run save-boundaries:check && npm run friends:check && npm run content && npm run species:check && npm run rules:check && npm run dungeons:check && npm run effects:check && npm run ai:check && npm run onboarding:check && npm run campaign:check && npm run navigation:check && node scripts/export-content-coverage.mjs --check && npm run assets && npm run vendor -- --check",
    "content": "node scripts/check-content.mjs",
    "content:coverage": "npm run content && node scripts/export-content-coverage.mjs",
    "pixel:export": "node art/pixel/export.mjs",
    "pixel:check": "node scripts/check-pixels.mjs",
    "pixel:capture": "node scripts/capture-pixels.mjs",
    "species:export": "node scripts/export-species.mjs",
    "species:check": "node scripts/check-species.mjs",
    "rules:check": "node scripts/check-rules.mjs",
    "dungeons:export": "node scripts/export-dungeons.mjs",
    "dungeons:check": "node scripts/check-dungeons.mjs",
    "effects:export": "node scripts/export-effects.mjs",
    "effects:check": "node scripts/check-effects.mjs",
    "production:export": "node art/production/export.mjs",
    "production:check": "node scripts/check-production-pixels.mjs",
    "production:capture": "node scripts/capture-production-pixels.mjs",
    "runtime-pixels:export": "node scripts/export-runtime-pixels.mjs",
    "runtime-pixels:check": "node scripts/check-runtime-pixels.mjs",
    "onboarding:export": "node scripts/export-onboarding.mjs",
    "onboarding:check": "node scripts/check-onboarding.mjs",
    "environment:export": "node scripts/export-environments.mjs",
    "environment:check": "node scripts/check-environments.mjs",
    "environment:capture": "node scripts/capture-environments.mjs",
    "campaign:export": "node scripts/export-campaign.mjs",
    "campaign:check": "node scripts/check-campaign.mjs",
    "navigation:export": "node scripts/export-navigation.mjs",
    "navigation:check": "node scripts/check-navigation.mjs",
    "roster:check": "node scripts/check-roster-pixels.mjs",
    "roster:export": "node art/roster/export.mjs",
    "roster:capture": "node scripts/capture-roster-pixels.mjs",
    "preroster:check": "node art/roster/export.mjs --materialize",
    "save-boundaries:check": "node scripts/check-save-boundaries.mjs",
    "ai:export": "node scripts/export-ai-facts.mjs",
    "ai:check": "node scripts/export-ai-facts.mjs --check",
    "friends:check": "node scripts/check-friend-facts.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "@types/three": "0.186.0",
    "acorn": "8.18.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.10.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "terser": "5.51.2",
    "three": "0.186.1",
    "typescript": "6.0.3"
  }
}
