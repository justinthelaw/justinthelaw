{
  "name": "justinthelaw",
  "version": "1.0.0",
  "description": "Justin Law's customizable personal website with an AI chatbot",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.19.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "postbuild": "node scripts/export-games.mjs",
    "start": "node scripts/serve-static-preview.mjs",
    "lint": "eslint .",
    "pretest": "playwright install",
    "test": "playwright test",
    "deploy": "npm run build && gh-pages -d out",
    "clean": "rm -rf out test-results playwright-report .next test-results.json",
    "flight-check": "npm run clean && npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "next": "^16.4.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.24.8",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "baseline-browser-mapping": "^2.11.27",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "brace-expansion": "5.0.12",
    "nanoid": "3.3.20",
    "postcss": "$postcss",
    "protobufjs": "7.6.6",
    "sharp": "0.35.5"
  },
  "allowScripts": {
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true
  }
}
