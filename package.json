{
  "name": "justinthelaw",
  "version": "1.0.0",
  "description": "Justin Law's customizable personal website with an AI chatbot",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=12.0.2"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "node scripts/serve-static-preview.mjs",
    "lint": "eslint .",
    "pretest": "playwright install",
    "test": "playwright test",
    "deploy": "npm run build && gh-pages -d out",
    "clean": "rm -rf out test-results playwright-report .next test-results.json",
    "flight-check": "npm run clean && npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.33.0",
    "next": "^16.3.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "baseline-browser-mapping": "^2.11.15",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "postcss": "$postcss",
    "protobufjs": "7.6.5",
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "onnxruntime-node@1.24.3": true,
    "protobufjs@7.6.5": true,
    "sharp@0.35.3": true
  }
}
