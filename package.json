{
  "name": "justinthelaw",
  "version": "1.0.0",
  "description": "Justin Law's customizable personal website with an AI chatbot",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "npm@12.0.1",
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=12.0.1"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "node scripts/serve-static-preview.mjs",
    "lint": "eslint .",
    "pretest": "playwright install",
    "test": "playwright test",
    "deploy": "npm run build && gh-pages -d out",
    "clean": "rm -rf out test-results playwright-report .next test-results.json",
    "flight-check": "npm run clean && npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "@deemlol/next-icons": "^0.2.7",
    "@huggingface/transformers": "^4.2.0",
    "framer-motion": "^12.42.2",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.17.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "baseline-browser-mapping": "^2.10.43",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "postcss": "$postcss"
  },
  "allowScripts": {
    "onnxruntime-node@1.24.3": true,
    "protobufjs@7.6.4": true,
    "sharp@0.34.5": true
  }
}
